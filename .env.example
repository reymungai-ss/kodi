# Copy this file to .env (for running on your computer) and fill it in.
# On Railway/Render, enter the same names and values in the dashboard instead.

# The password Chord sends to Kodi. Make a long random one: `openssl rand -hex 32`
KODI_MCP_TOKEN=

# From the Apps Script deployment (ends in /exec)
SHEET_WEBAPP_URL=
# The same value you saved as SHEET_WEBAPP_SECRET in the Apps Script's Script properties
SHEET_WEBAPP_SECRET=

# Paystack dashboard → Settings → API Keys & Webhooks → Test Secret Key (starts with sk_test_)
PAYSTACK_SECRET_KEY=

# Optional. Domain for the per-unit email Paystack requires (a1@<domain>).
# Default: tenants.baraka-court.example.com (Paystack rejects .test addresses).
# TENANT_EMAIL_DOMAIN=

# Optional. Railway/Render set this for you.
# PORT=3000
